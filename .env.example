# Copy to .env and fill in. The app runs fully without an LLM (rule-based mode).

# --- GPU on RunPod: python -m scripts.gpu create | start | stop | status --------
# Your RunPod API key (RunPod -> Settings -> API Keys). Keep it only here: never in chat or git.
RUNPOD_API_KEY=
# Filled in by `python -m scripts.gpu create` (together with LLM_BASE_URL and LLM_API_KEY below).
RUNPOD_POD_ID=
# SECURE (reliable, $0.59/h for an RTX A6000) or COMMUNITY (cheaper, $0.33/h, fewer free GPUs).
GPU_CLOUD=SECURE
# The pod stops itself after this many minutes without a request to the model.
IDLE_MINUTES=20

# --- Language model (any OpenAI-compatible endpoint) -------------------------
# RunPod pod running vLLM:        https://<POD_ID>-8000.proxy.runpod.net/v1
# RunPod Serverless vLLM:         https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
# Local Ollama / LM Studio:       http://localhost:11434/v1  /  http://localhost:1234/v1
LLM_BASE_URL=
# The --api-key you started vLLM with (pod; `scripts.gpu create` sets it), or your RunPod API key (serverless).
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B-FP8
LLM_TIMEOUT=90
# Qwen3.x "thinks" by default; JSON extraction is faster and more reliable without it.
LLM_DISABLE_THINKING=true

# --- Trend sources ----------------------------------------------------------
# Optional: a free OpenAlex key raises the daily budget from ~$0.10 to $1 (https://openalex.org/settings/api)
OPENALEX_API_KEY=
OPENALEX_MAILTO=
HN_MONTHS=36

# --- Certificates ------------------------------------------------------------
# Secret that signs Path.AI certificates (any long random string). Keep it stable:
# changing it makes previously issued certificate links fail verification.
# If empty, a key is generated once in data/cache/cert_secret (fine for local use).
CERT_SECRET=
