 "quiz": {
  "questions": [
   {
    "q": "What does the lesson suggest as a good way to measure the potential harm of a generative AI application?",
    "options": [
     "Measuring how fast the model answers",
     "Counting how many users sign up",
     "Testing a diverse set of prompts that users are most likely to use",
     "Asking the model whether it is harmful"
    ],
    "answer": 2,
    "explain": "Builders should keep a wide, diverse user base in mind and test the prompts real users will send.",
    "lesson": "ai_governance-01",
    "evidence": "testing a diverse set of prompts users are most likely going to use is a good way to measure potential harm.",
    "origin": "authored"
   },
   {
