 "quiz": {
  "questions": [
   {
    "q": "Why must human-centred design solutions keep adapting after launch?",
    "options": [
     "Because technology always fails",
     "Because funding changes every year",
     "Because people and their needs are dynamic and changing",
     "Because designers get bored"
    ],
    "answer": 2,
    "explain": "Measure effectiveness against the original aims and keep improving.",
    "lesson": "creative_thinking-01",
    "evidence": "HCD recognizes that people and their needs are dynamic and changing, and so solutions must also adapt to changing needs.",
    "origin": "authored"
   },
   {
    "q": "What is human-centred design (HCD)?",
    "options": [
     "A qualitative research method to solve problems with solutions that put customer needs ahead of a system's needs",
     "A way to design attractive logos",
     "A software development framework",
     "A method for cutting costs"
    ],
    "answer": 0,
    "explain": "It starts from people's real needs, not the organisation's processes.",
    "lesson": "creative_thinking-02",
    "evidence": "Human-centered design (HCD) is a qualitative research method that helps groups solve problems and seek solutions that prioritize customer needs over a system’s needs.",
    "origin": "authored"
   },
   {
    "q": "How should you think of an HCD discovery?",
    "options": [
     "As a one-off survey",
     "As the final step of a project",
     "As a straight line from start to finish",
     "As a cycle, not a linear process"
    ],
    "answer": 3,
    "explain": "Each round of learning sends you back to refine questions.",
    "lesson": "creative_thinking-02",
    "evidence": "Think of HCD discovery as a cycle, instead of a linear process.",
    "origin": "authored"
   },
   {
    "q": "What is participatory design?",
    "options": [
     "Letting the most senior person decide",
     "Giving participants an active role in the life cycle of the work",
     "Asking users to pay for the design",
     "Designing alone, then presenting to users"
    ],
    "answer": 1,
    "explain": "Participants act as equals to the design team and leadership.",
    "lesson": "creative_thinking-04",
    "evidence": "Giving participants an active role in the life cycle of our work is sometimes called participatory design.",
    "origin": "authored"
   },
   {
    "q": "What happens in the solution implementation step of the design process?",
    "options": [
     "The brief is written",
     "Research begins",
     "The final concept options are selected and carried through to completion",
     "The budget is approved"
    ],
    "answer": 2,
    "explain": "Implementation turns the chosen concept into finished designs.",
    "lesson": "creative_thinking-07",
    "evidence": "we are ready to select the final concept options and carry their application through to completion in producing the final design(s).",
    "origin": "authored"
   },
   {
    "q": "In a design studio session, what should you remind participants about sketching?",
    "options": [
     "Anyone can draw — artistic accuracy is not the goal",
     "Only designers should sketch",
     "Sketches must be in colour",
     "Sketches are graded"
    ],
    "answer": 0,
    "explain": "Quick, rough sketches let everyone contribute ideas.",
    "lesson": "creative_thinking-08",
    "evidence": "Remind them that anyone can draw and artistic accuracy is not the goal of the exercise.",
    "origin": "authored"
   },
   {
    "q": "Why should you map a user's whole problem?",
    "options": [
     "To make the project bigger",
     "To find more users to charge",
     "To replace other organisations' services",
     "Because what you are working on is probably part of a bigger task users are trying to complete"
    ],
    "answer": 3,
    "explain": "Mapping shows how the journey is delivered today and where to improve it.",
    "lesson": "creative_thinking-09",
    "evidence": "This is because what they’re working on is probably part of a bigger task that users are trying to complete.",
    "origin": "authored"
   },
   {
    "q": "Who are the creative thinkers, according to 'Words of Wisdom'?",
    "options": [
     "Those who always pick option A",
     "Those who invent solution C while everyone else argues between A and B",
     "Those who avoid making decisions",
     "Those who copy the best existing answer"
    ],
    "answer": 1,
    "explain": "Creative and critical thinking work together.",
    "lesson": "creative_thinking-10",
    "evidence": "They are the ones who invent solution C when everyone else is still arguing between A and B.",
    "origin": "authored"
   },
   {
