 "quiz": {
  "questions": [
   {
    "q": "What does using the marketing concept mean?",
    "options": [
     "Advertising before the product exists",
     "Creating the product after market research identifies customers' needs and wants",
     "Selling at the lowest possible price",
     "Focusing on production efficiency"
    ],
    "answer": 1,
    "explain": "Customer needs come first; the product follows.",
    "lesson": "digital_marketing-01",
    "evidence": "using the marketing concept means the product is created after market research is used to identify the needs and wants of the customers.",
    "origin": "authored"
   },
   {
    "q": "Why does a company identify a target market?",
    "options": [
     "To avoid paying taxes",
     "To sell to everyone equally",
     "To decide its office location",
     "To focus marketing efforts on those most likely to buy"
    ],
    "answer": 3,
    "explain": "Targeting makes the marketing mix fit a specific group.",
    "lesson": "digital_marketing-02",
    "evidence": "Identifying a target market helps a company focus its marketing efforts on those who are most likely to buy its products or services.",
    "origin": "authored"
   },
   {
    "q": "How should the strategies for the elements of the marketing mix relate to each other?",
    "options": [
     "A strategy is built for each element and all are blended together",
     "Only the price strategy matters",
     "Each department designs its element independently",
     "They should change every week"
    ],
    "answer": 0,
    "explain": "Product, place, promotion, price and people must work as one plan.",
    "lesson": "digital_marketing-03",
    "evidence": "A strategy must be constructed for each of the 5Ps, and all strategies must be blended with the strategies of the other elements.",
    "origin": "authored"
   },
